{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "findings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "findings"],
  "properties": {
    "schema_version": {"const": 2},
    "findings": {
      "type": "array",
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/line_finding"},
          {"$ref": "#/$defs/file_finding"}
        ]
      }
    }
  },
  "$defs": {
    "line_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "severity",
        "title",
        "path",
        "anchor_kind",
        "side",
        "start_line",
        "end_line",
        "existing_code",
        "trigger",
        "impact",
        "evidence",
        "fix_direction"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "title": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "anchor_kind": {"const": "line"},
        "side": {"enum": ["before", "after"]},
        "start_line": {"type": "integer", "minimum": 1},
        "end_line": {"type": "integer", "minimum": 1},
        "existing_code": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "fix_direction": {"type": "string", "minLength": 1}
      }
    },
    "file_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "severity",
        "title",
        "path",
        "anchor_kind",
        "metadata_changes",
        "trigger",
        "impact",
        "evidence",
        "fix_direction"
      ],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "title": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "anchor_kind": {"const": "file"},
        "metadata_changes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "trigger": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "evidence": {"type": "string", "minLength": 1},
        "fix_direction": {"type": "string", "minLength": 1}
      }
    }
  }
}
