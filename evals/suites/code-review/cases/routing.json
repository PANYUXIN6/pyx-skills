    "deterministic_assertions": [
      {"id": "comparison-skill-read", "kind": "event_matches", "pattern": "code-review[^\\n]*SKILL\\.md", "critical": false},
      {"id": "comparison-workflow-read", "kind": "event_matches", "pattern": "acceptance-review\\.md", "critical": false},
