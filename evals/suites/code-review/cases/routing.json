    "module": "acceptance",
    "tags": ["smoke", "critical"],
    "activation": "automatic",
    "skill_invocation_expected": true,
    "prompt": "As a final acceptance review, determine whether the change set since Git baseline missing-ref satisfies SPEC.md. The comparison and change attribution are required; stop without a conclusion if that baseline is invalid. Keep the workspace unchanged.",
