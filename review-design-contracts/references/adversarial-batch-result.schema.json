{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "adversarial-batch-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_results"
  ],
  "properties": {
    "finding_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "result"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "result": {
            "$ref": "adversarial-result.schema.json"
          }
        }
      }
    }
  }
}
