{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["responses"],
  "properties": {
    "responses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "position"],
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "position": {
                "const": "acknowledge"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "position", "reason", "anchors"],
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "position": {
                "const": "counterevidence"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "anchors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "quote"],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "heading": {
                      "type": "string",
                      "minLength": 1
                    },
                    "quote": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding_id", "position", "reason"],
            "properties": {
              "finding_id": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "position": {
                "const": "unrecorded_intent"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  }
}
