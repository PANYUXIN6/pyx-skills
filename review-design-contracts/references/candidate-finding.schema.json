{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-finding.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates"],
      "properties": {
        "candidates": {
          "$ref": "#/$defs/candidate_list"
        }
      }
    },
    {
      "$ref": "insufficient-result.schema.json"
    }
  ],
  "$defs": {
    "candidate_list": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "heading", "quote"],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "action", "result"],
      "properties": {
        "actor": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_state", "steps", "derived_outcome"],
      "properties": {
        "initial_state": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "derived_outcome": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "violation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "actual"],
      "properties": {
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "actual": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "procedure", "oracle"],
      "properties": {
        "mode": {
          "enum": ["executable", "static_trace", "spec_counterexample"]
        },
        "procedure": {
          "type": "string",
          "minLength": 1
        },
        "oracle": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layer",
        "claim",
        "contract",
        "trigger",
        "violation",
        "verification"
      ],
      "properties": {
        "layer": {
          "enum": ["self_consistency", "architecture"]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "evidence_sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "heading"],
            "properties": {
              "source": {
                "type": "string",
                "minLength": 1
              },
              "heading": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "contract": {
          "$ref": "#/$defs/contract"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "violation": {
          "$ref": "#/$defs/violation"
        },
        "verification": {
          "$ref": "#/$defs/verification"
        }
      }
    }
  }
}
