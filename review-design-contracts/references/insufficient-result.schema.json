{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "insufficient-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_status", "missing_inputs"],
  "properties": {
    "task_status": {
      "const": "insufficient_input"
    },
    "missing_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
