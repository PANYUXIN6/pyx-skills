{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-shard-result.schema.json",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["contracts", "candidates", "cross_shard_signals"],
      "properties": {
        "contracts": {
          "$ref": "contract-ledger.schema.json#/properties/contracts"
        },
        "candidates": {
          "$ref": "candidate-finding.schema.json#/$defs/candidate_list"
        },
        "cross_shard_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source",
              "heading",
              "counterpart_source",
              "counterpart_heading",
              "reason"
            ],
            "properties": {
              "source": { "type": "string", "minLength": 1 },
              "heading": { "type": "string", "minLength": 1 },
              "counterpart_source": { "type": "string", "minLength": 1 },
              "counterpart_heading": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "$ref": "insufficient-result.schema.json"
    }
  ]
}
