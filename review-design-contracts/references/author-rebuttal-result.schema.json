{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "author-rebuttal-result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["results"],
  "properties": {
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding_id", "outcome", "evidence"],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "outcome": {
            "enum": ["refuted", "survives", "new_authority_required"]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
